# ==============================================================================
# VARIABLES DE ENTORNO - RIQCHARIY FINANZAS BACKEND
# ==============================================================================
# Este archivo es una PLANTILLA. Copia este archivo a .env y configura los valores.
#
# Instrucciones:
#   1. Copiar: copy .env.example .env
#   2. Editar .env con tus valores reales
#   3. NUNCA subir .env al repositorio (está en .gitignore)
# ==============================================================================

# ------------------------------------------------------------------------------
# CONFIGURACIÓN GENERAL
# ------------------------------------------------------------------------------
# Nombre del proyecto (usado en documentación de la API)
PROJECT_NAME=Riqchariy Finanzas API

# Entorno de ejecución: development | staging | production
ENVIRONMENT=development

# Modo debug (True solo en desarrollo)
DEBUG=True

# ------------------------------------------------------------------------------
# SERVIDOR
# ------------------------------------------------------------------------------
# Host y puerto donde corre el servidor
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# SEGURIDAD - JWT
# ------------------------------------------------------------------------------
# Clave secreta para firmar tokens JWT (CAMBIAR EN PRODUCCIÓN)
# Generar con: openssl rand -hex 32
SECRET_KEY=tu-clave-secreta-aqui-cambiar-en-produccion

# Algoritmo de encriptación JWT
JWT_ALGORITHM=HS256

# Tiempo de expiración del token en minutos (1440 = 24 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# CORS - Orígenes permitidos
# ------------------------------------------------------------------------------
# Lista de URLs del frontend separadas por comas
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# BASE DE DATOS (Descomentar cuando se configure)
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql+asyncpg://usuario:password@localhost:5432/riqchariy_db

# ------------------------------------------------------------------------------
# INTEGRACIONES EXTERNAS (Descomentar cuando se necesiten)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-tu-api-key-aqui
# AZURE_OPENAI_KEY=tu-azure-key-aqui
